import numpy as np
from sklearn.decomposition import PCA
from sklearn.cluster import KMeans

# Load the trace file
trace_file = './trace/RSA-SC-451129.npy'
waveform = np.load(trace_file)

# Step 1: Segmentation
num_segments = 1561
segment_length = len(waveform) // num_segments
segments = np.array([waveform[i * segment_length:(i + 1) * segment_length] for i in range(num_segments)])

# Step 2: Dimensionality Reduction and Clustering
# Apply PCA for dimensionality reduction
pca = PCA(n_components=2)
reduced_segments = pca.fit_transform(segments)

# Apply KMeans clustering
kmeans = KMeans(n_clusters=2, random_state=42)
labels = kmeans.fit_predict(reduced_segments)

# Assign labels: Larger cluster is S, smaller cluster is M
label_counts = np.bincount(labels)
s_label = np.argmax(label_counts)  # Label for S
m_label = 1 - s_label  # Label for M

# Map labels to operations
operations = ''.join(['S' if label == s_label else 'M' for label in labels])

# Step 3: Constraint Verification
s_count = operations.count('S')
constraint_1 = (s_count == 1024)
constraint_2 = (operations[0] == 'S')
constraint_3 = ('MM' not in operations)

# Print results
print("S count:", s_count)
print("Constraint 1 (1024 S operations):", "Pass" if constraint_1 else "Fail")
print("Constraint 2 (First operation is S):", "Pass" if constraint_2 else "Fail")
print("Constraint 3 (No consecutive M operations):", "Pass" if constraint_3 else "Fail")

# Save operations to file
with open('./result.txt', 'w') as f:
    f.write(operations)
