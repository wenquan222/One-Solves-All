import numpy as np
from sklearn.decomposition import PCA
from sklearn.cluster import KMeans

# Load the trace file
trace_file = './trace/Simulated-6-20.npy'
waveform = np.load(trace_file)

# Step 1: Segmentation
num_operations = 1536
segment_length = len(waveform) // num_operations
segments = np.array([waveform[i * segment_length:(i + 1) * segment_length] for i in range(num_operations)])

# Step 2: Dimensionality Reduction and Clustering
# Apply PCA for dimensionality reduction
pca = PCA(n_components=2)
reduced_segments = pca.fit_transform(segments)

# Apply KMeans clustering
kmeans = KMeans(n_clusters=2, random_state=42)
labels = kmeans.fit_predict(reduced_segments)

# Assign the larger cluster as S and the smaller as M
if np.sum(labels) > len(labels) // 2:
    labels = 1 - labels

# Step 3: Constraint Verification
s_count = np.sum(labels == 0)
m_count = np.sum(labels == 1)
first_operation_s = labels[0] == 0
no_consecutive_m = all((labels[i] == 1 and labels[i + 1] == 1) == False for i in range(len(labels) - 1))

# Print results
print("S count:", s_count)
print("M count:", m_count)
print("First operation is S:", first_operation_s)
print("No consecutive M operations:", no_consecutive_m)

# Save the operation sequence to a file
operation_sequence = ''.join(['S' if label == 0 else 'M' for label in labels])
with open('./result.txt', 'w') as f:
    f.write(operation_sequence)

# Output constraint verification results
s_count, first_operation_s, no_consecutive_m
