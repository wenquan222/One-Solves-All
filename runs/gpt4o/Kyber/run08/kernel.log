import numpy as np
from sklearn.decomposition import PCA
from sklearn.cluster import KMeans

# Load the waveform
trace_file = './trace/Kyber-34560.npy'
waveform = np.load(trace_file)

# Step 1: Segmentation
num_segments = 256
segment_length = len(waveform) // num_segments
segments = np.array([waveform[i * segment_length:(i + 1) * segment_length] for i in range(num_segments)])

# Step 2: Dimensionality Reduction (PCA)
pca = PCA(n_components=1)  # Reduce to 1 dimension
reduced_segments = pca.fit_transform(segments)

# Step 3: Clustering (KMeans)
kmeans = KMeans(n_clusters=2, random_state=0)
labels = kmeans.fit_predict(reduced_segments)

# Assign the larger cluster to 0 (assuming 0 is more frequent)
cluster_0_count = np.sum(labels == 0)
cluster_1_count = np.sum(labels == 1)
if cluster_0_count > cluster_1_count:
    bit_sequence = labels
else:
    bit_sequence = 1 - labels  # Invert labels

# Convert bit sequence to string
bit_sequence_str = ''.join(map(str, bit_sequence))

# Save to file
output_file = './result.txt'
with open(output_file, 'w') as f:
    f.write(bit_sequence_str)

# Return the bit sequence and confirmation of file save
bit_sequence_str, f"Bit sequence saved to {output_file}"
