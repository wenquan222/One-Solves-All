import numpy as np
from sklearn.decomposition import PCA
from sklearn.cluster import KMeans

# Load the trace file
trace_file = './trace/Simulated-4-20.npy'
waveform = np.load(trace_file)

# Step 1: Segmentation
num_operations = 1536
segment_length = len(waveform) // num_operations
segments = np.array([waveform[i * segment_length:(i + 1) * segment_length] for i in range(num_operations)])

# Step 2: Dimensionality Reduction and Clustering
# Apply PCA for dimensionality reduction
pca = PCA(n_components=2)
reduced_segments = pca.fit_transform(segments)

# Apply KMeans clustering
kmeans = KMeans(n_clusters=2, random_state=42)
labels = kmeans.fit_predict(reduced_segments)

# Assign the larger cluster as S and the smaller as M
if np.sum(labels) > len(labels) // 2:
    labels = 1 - labels

# Step 3: Constraint Verification
operation_sequence = ''.join(['S' if label == 0 else 'M' for label in labels])

# Constraint 1: Count of S operations
s_count = operation_sequence.count('S')
constraint_1 = (s_count == 1024)

# Constraint 2: First operation is S
constraint_2 = (operation_sequence[0] == 'S')

# Constraint 3: No two consecutive M operations
constraint_3 = ('MM' not in operation_sequence)

# Print results
print(f"S count: {s_count}, Constraint 1: {'Pass' if constraint_1 else 'Fail'}")
print(f"Constraint 2: {'Pass' if constraint_2 else 'Fail'}")
print(f"Constraint 3: {'Pass' if constraint_3 else 'Fail'}")

# Save the operation sequence to a file
if constraint_1 and constraint_2 and constraint_3:
    with open('./result.txt', 'w') as f:
        f.write(operation_sequence)
