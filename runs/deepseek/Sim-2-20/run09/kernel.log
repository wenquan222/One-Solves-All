# Step 2: Dimensionality Reduction and Clustering
# Standardize the data first
scaler = StandardScaler()
segments_scaled = scaler.fit_transform(segments)

# Apply PCA
pca = PCA(n_components=10)  # Start with 10 components
pca_features = pca.fit_transform(segments_scaled)

print(f"Explained variance ratio: {pca.explained_variance_ratio_}")
print(f"Cumulative explained variance: {np.cumsum(pca.explained_variance_ratio_)}")

# Apply KMeans clustering
kmeans = KMeans(n_clusters=2, random_state=42, n_init=10)
labels = kmeans.fit_predict(pca_features)

# Determine which cluster is S (larger cluster)
cluster_counts = np.bincount(labels)
print(f"Cluster counts: {cluster_counts}")

# Assign larger cluster as S (squaring)
if cluster_counts[0] > cluster_counts[1]:
    s_label, m_label = 0, 1
else:
    s_label, m_label = 1, 0

# Convert labels to S and M
operations = []
for label in labels:
    if label == s_label:
        operations.append('S')
    else:
        operations.append('M')

operations = np.array(operations)

# Step 3: Constraint Verification
s_count = np.sum(operations == 'S')
first_op = operations[0]
consecutive_m = False
for i in range(1, len(operations)):
    if operations[i] == 'M' and operations[i-1] == 'M':
        consecutive_m = True
        break

print("\n=== ATTEMPT 1 RESULTS ===")
print(f"S count: {s_count} (target: 1024)")
print(f"First operation: {first_op} (target: S)")
print(f"Consecutive M operations: {consecutive_m} (target: False)")
print(f"All constraints satisfied: {s_count == 1024 and first_op == 'S' and not consecutive_m}")

# Plot PCA components colored by cluster
plt.figure(figsize=(10, 6))
colors = ['red' if op == 'M' else 'blue' for op in operations]
plt.scatter(pca_features[:, 0], pca_features[:, 1], c=colors, alpha=0.6)
plt.title('PCA Components Colored by Operation Type (Red=M, Blue=S)')
plt.xlabel('PC1')
plt.ylabel('PC2')

