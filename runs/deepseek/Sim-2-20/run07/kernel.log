for i in range(len(operation_sequence) - 1):
    if operation_sequence[i] == 'M' and operation_sequence[i+1] == 'M':
        consecutive_m_found = True
        print(f"Found consecutive M at positions {i} and {i+1}")
        break

if not consecutive_m_found:
