# Segment the waveform into 188 equal parts
n_segments = 188
segment_length = len(trace_data) // n_segments
print(f"Total samples: {len(trace_data)}")
print(f"Segment length: {segment_length}")
print(f"Total segments: {n_segments}")

# Create segments
