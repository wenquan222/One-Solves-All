# Verify the sequence more thoroughly
print("Detailed sequence verification:")

# Create the operation sequence
operation_sequence = []
for label in labels:
    if label == s_cluster:
        operation_sequence.append('S')
    else:
        operation_sequence.append('M')

sequence_str = ''.join(operation_sequence)
print(f"First 50 operations: {sequence_str[:50]}")
print(f"Last 50 operations: {sequence_str[-50:]}")

# Double-check constraints
print("\nFinal Constraint Verification:")
print(f"1. Total S count: {sequence_str.count('S')} (expected: 1024)")
print(f"2. First operation: {sequence_str[0]}")

# Check for consecutive M operations
consecutive_m_found = False
for i in range(1, len(sequence_str)):
    if sequence_str[i] == 'M' and sequence_str[i-1] == 'M':
        consecutive_m_found = True
        print(f"Found consecutive M at positions {i-1} and {i}")
        break

if not consecutive_m_found:
    print("3. No consecutive M operations found")

print(f"\nSequence length: {len(sequence_str)}")
print(f"S operations: {sequence_str.count('S')}")
print(f"M operations: {sequence_str.count('M')}")

# Save to file
with open('./result.txt', 'w') as f:
    f.write(sequence_str)

print("\nSequence successfully saved to ./result.txt")
