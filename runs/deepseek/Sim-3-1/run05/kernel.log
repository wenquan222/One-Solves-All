import numpy as np
import matplotlib.pyplot as plt
from sklearn.decomposition import PCA
from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler

# Load the trace data
trace = np.load('./trace/Simulated-3-1.npy')
print(f"Trace shape: {trace.shape}")
print(f"Trace length: {len(trace)}")

# Step 1: Segment the waveform into 1536 equal parts
num_operations = 1536
segment_length = len(trace) // num_operations
print(f"Segment length: {segment_length}")

# Create segments
segments = []
for i in range(num_operations):
    start_idx = i * segment_length
    end_idx = (i + 1) * segment_length
    segment = trace[start_idx:end_idx]
    segments.append(segment)

segments = np.array(segments)
print(f"Segments shape: {segments.shape}")


try:
    import matplotlib.pyplot as plt
    import json as _json
    plt.savefig("../images/img_20261006_174828_673365_1.png", dpi=160, bbox_inches='tight')
    plt.close()
    print(_json.dumps({"plot_path": "../images/img_20261006_174828_673365_1.png"}, ensure_ascii=False))
except Exception as e:
    print("图片保存失败:", str(e))

