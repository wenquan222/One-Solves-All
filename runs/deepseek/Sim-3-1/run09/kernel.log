        dbscan = DBSCAN(eps=eps, min_samples=5)
        labels6 = dbscan.fit_predict(segments_pca6)
        unique_labels = np.unique(labels6)
        print(f"eps={eps}: {len(unique_labels)} clusters")
        if len(unique_labels) == 2:
            break

