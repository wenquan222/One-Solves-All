# Final verification and sequence generation
sequence = []
for label in labels:
    if label == s_cluster:
        sequence.append('S')
    else:
        sequence.append('M')

sequence_str = ''.join(sequence)

print(f"Final sequence length: {len(sequence_str)}")
print(f"First 50 operations: {sequence_str[:50]}")
print(f"Last 50 operations: {sequence_str[-50:]}")

# Verify constraints one more time
print("\nFinal Constraint Verification:")
print(f"1. Exactly 1024 S operations: {sequence_str.count('S') == 1024} ({sequence_str.count('S')} found)")
print(f"2. First operation is S: {sequence_str[0] == 'S'}")

# Check for consecutive M operations
consecutive_m_found = False
for i in range(1, len(sequence_str)):
    if sequence_str[i] == 'M' and sequence_str[i-1] == 'M':
        consecutive_m_found = True
        print(f"Consecutive M found at positions {i-1} and {i}")
        break
print(f"3. No two consecutive M operations: {not consecutive_m_found}")

# Save to file
with open('./result.txt', 'w') as f:
    f.write(sequence_str)

print(f"\nSequence successfully saved to ./result.txt")
print(f"File contains {len(sequence_str)} characters")
