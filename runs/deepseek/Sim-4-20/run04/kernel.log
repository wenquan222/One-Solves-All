# Extract features from segments (using the entire segment as features)
X = segments

# Standardize the data
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# Apply PCA
pca = PCA(n_components=2)
X_pca = pca.fit_transform(X_scaled)

print(f"Explained variance ratio: {pca.explained_variance_ratio_}")
print(f"Total explained variance: {sum(pca.explained_variance_ratio_)}")

# Apply KMeans clustering
kmeans = KMeans(n_clusters=2, random_state=42)
labels = kmeans.fit_predict(X_pca)

# Assign larger cluster as S (squaring)
cluster_counts = np.bincount(labels)
print(f"Cluster counts: {cluster_counts}")

if cluster_counts[0] > cluster_counts[1]:
    # Cluster 0 is larger, so assign it as S
    s_label = 0
    m_label = 1
else:
    # Cluster 1 is larger, so assign it as S
    s_label = 1
    m_label = 0

# Convert labels to S and M
operations = []
for label in labels:
    if label == s_label:
        operations.append('S')
    else:
        operations.append('M')

operations = np.array(operations)

# Verify constraints
s_count = np.sum(operations == 'S')
first_is_s = operations[0] == 'S'

# Check for consecutive M operations
consecutive_m = False
for i in range(1, len(operations)):
    if operations[i] == 'M' and operations[i-1] == 'M':
        consecutive_m = True
        break

print(f"\nConstraint Verification:")
print(f"1. S count: {s_count} (target: 1024) - {'PASS' if s_count == 1024 else 'FAIL'}")
print(f"2. First operation is S: {first_is_s} - {'PASS' if first_is_s else 'FAIL'}")
print(f"3. No consecutive M operations: {not consecutive_m} - {'PASS' if not consecutive_m else 'FAIL'}")

# Plot PCA results
plt.figure(figsize=(8, 6))
colors = ['red' if op == 'M' else 'blue' for op in operations]
plt.scatter(X_pca[:, 0], X_pca[:, 1], c=colors, alpha=0.6)
plt.title('PCA + KMeans Clustering (Red=M, Blue=S)')
plt.xlabel('PC1')
plt.ylabel('PC2')

