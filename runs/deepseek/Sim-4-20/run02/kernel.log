# Step 2: Dimensionality reduction and clustering
# Standardize the data
scaler = StandardScaler()
segments_scaled = scaler.fit_transform(segments)

# Apply PCA
pca = PCA(n_components=2)
segments_pca = pca.fit_transform(segments_scaled)

# Apply KMeans clustering
kmeans = KMeans(n_clusters=2, random_state=42)
labels = kmeans.fit_predict(segments_pca)

# Assign larger cluster as S (squaring)
cluster_counts = np.bincount(labels)
print(f"Cluster counts: {cluster_counts}")

# Determine which cluster is larger
if cluster_counts[0] > cluster_counts[1]:
    s_cluster = 0
    m_cluster = 1
else:
    s_cluster = 1
    m_cluster = 0

# Create operation labels
operations = []
for label in labels:
    if label == s_cluster:
        operations.append('S')
    else:
        operations.append('M')

operations = np.array(operations)

# Step 3: Constraint verification
s_count = np.sum(operations == 'S')
first_op = operations[0]

# Check for consecutive M operations
consecutive_m = False
for i in range(1, len(operations)):
    if operations[i] == 'M' and operations[i-1] == 'M':
        consecutive_m = True
        break

print(f"\n--- Attempt 1 Results ---")
print(f"S count: {s_count} (target: 1024)")
print(f"First operation: {first_op} (target: S)")
print(f"Consecutive M operations: {consecutive_m} (target: False)")

# Check if all constraints are satisfied
constraints_satisfied = (s_count == 1024) and (first_op == 'S') and (not consecutive_m)
print(f"All constraints satisfied: {constraints_satisfied}")

# Visualize the clustering
plt.figure(figsize=(10, 6))
plt.scatter(segments_pca[operations == 'S', 0], segments_pca[operations == 'S', 1], 
            c='blue', label='S (Squaring)', alpha=0.6)
plt.scatter(segments_pca[operations == 'M', 0], segments_pca[operations == 'M', 1], 
            c='red', label='M (Multiplication)', alpha=0.6)
plt.xlabel('PC1')
plt.ylabel('PC2')
plt.title('PCA + KMeans Clustering (Attempt 1)')
plt.legend()
plt.grid(True)

