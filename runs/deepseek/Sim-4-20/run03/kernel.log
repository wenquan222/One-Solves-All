# Verify the sequence more thoroughly
print("Detailed sequence verification:")
print(f"Total operations: {len(operations)}")
print(f"S operations: {s_count}")
print(f"M operations: {len(operations) - s_count}")

# Check for consecutive M operations more carefully
consecutive_m_positions = []
for i in range(len(operations)-1):
    if operations[i] == 'M' and operations[i+1] == 'M':
        consecutive_m_positions.append(i)

print(f"Consecutive M operations found at positions: {consecutive_m_positions}")
print(f"First 20 operations: {''.join(operations[:20])}")
print(f"Last 20 operations: {''.join(operations[-20:])}")

# Verify the sequence pattern (should be square-and-multiply)
# Count the occurrences of patterns
patterns = {}
for i in range(len(operations)-1):
    pattern = operations[i] + operations[i+1]
    patterns[pattern] = patterns.get(pattern, 0) + 1

print(f"\nPattern frequencies:")
for pattern, count in sorted(patterns.items()):
    print(f"{pattern}: {count}")

# Final verification
all_constraints_satisfied = (s_count == 1024 and 
                           operations[0] == 'S' and 
                           len(consecutive_m_positions) == 0)

print(f"\nAll constraints satisfied: {all_constraints_satisfied}")
