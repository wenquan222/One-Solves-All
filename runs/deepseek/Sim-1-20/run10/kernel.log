for i in range(10):
    color = 'red' if operations[i] == 'M' else 'blue'
    plt.plot(segments[i], color=color, alpha=0.7, label=f'Op {i}: {operations[i]}' if i < 3 else "")
plt.xlabel('Sample')
plt.ylabel('Power')
plt.title('First 10 Operations')
if i < 3:
    plt.legend()

# Plot operation sequence pattern
