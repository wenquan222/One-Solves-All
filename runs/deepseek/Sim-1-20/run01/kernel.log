# Step 2: Dimensionality Reduction and Clustering
# Flatten segments for PCA
X = segments.reshape(segments.shape[0], -1)

# Standardize the data
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# Apply PCA
pca = PCA(n_components=2)
X_pca = pca.fit_transform(X_scaled)

# Apply KMeans clustering
kmeans = KMeans(n_clusters=2, random_state=42, n_init=10)
labels = kmeans.fit_predict(X_pca)

# Determine which cluster is S (larger cluster)
cluster_counts = np.bincount(labels)
if cluster_counts[0] > cluster_counts[1]:
    s_cluster = 0
    m_cluster = 1
else:
    s_cluster = 1
    m_cluster = 0

# Convert labels to S and M
operations = []
for label in labels:
    if label == s_cluster:
        operations.append('S')
    else:
        operations.append('M')

operations = np.array(operations)

# Step 3: Constraint Verification
s_count = np.sum(operations == 'S')
first_op = operations[0]

# Check for consecutive M operations
consecutive_m = False
for i in range(1, len(operations)):
    if operations[i] == 'M' and operations[i-1] == 'M':
        consecutive_m = True
        break

print("=== Attempt 1: PCA (2 components) + KMeans ===")
print(f"S count: {s_count} (target: 1024)")
print(f"First operation: {first_op} (target: S)")
print(f"Consecutive M operations: {consecutive_m} (target: False)")
print(f"All constraints satisfied: {s_count == 1024 and first_op == 'S' and not consecutive_m}")

# Plot the PCA results
plt.figure(figsize=(10, 6))
plt.scatter(X_pca[operations == 'S', 0], X_pca[operations == 'S', 1], c='blue', label='S', alpha=0.6)
plt.scatter(X_pca[operations == 'M', 0], X_pca[operations == 'M', 1], c='red', label='M', alpha=0.6)
plt.xlabel('PC1')
plt.ylabel('PC2')
plt.title('PCA + KMeans Clustering (Attempt 1)')
plt.legend()
plt.grid(True)

