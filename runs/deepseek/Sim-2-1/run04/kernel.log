# Additional verification to ensure the sequence is valid
print("Detailed sequence verification:")
print(f"Total operations: {len(operations)}")
print(f"S operations: {s_count}")
print(f"M operations: {len(operations) - s_count}")

# Check for consecutive M operations more thoroughly
consecutive_m_positions = []
for i in range(len(operations)-1):
    if operations[i] == 'M' and operations[i+1] == 'M':
        consecutive_m_positions.append(i)

if consecutive_m_positions:
    print(f"Found consecutive M operations at positions: {consecutive_m_positions}")
else:
    print("No consecutive M operations found - constraint satisfied")

# Check first and last operations
print(f"First operation: {operations[0]}")
print(f"Last operation: {operations[-1]}")

# Display first 50 operations as a sample
print(f"\nFirst 50 operations: {''.join(operations[:50])}")

# Save the complete sequence to file
with open('./result.txt', 'w') as f:
    f.write(''.join(operations))

print(f"\nSequence successfully saved to ./result.txt")
