# Final verification of the clustering results
print("=== FINAL VERIFICATION ===")

# Get the final labels with correct S/M assignment
final_labels = []
for label in labels:
    if label == s_cluster:
        final_labels.append('S')
    else:
        final_labels.append('M')

# Convert to sequence
sequence = ''.join(final_labels)

# Verify all constraints
s_count = sequence.count('S')
m_count = sequence.count('M')

print(f"Total operations: {len(sequence)}")
print(f"S operations: {s_count}")
print(f"M operations: {m_count}")

# Check constraints
constraint_1 = (s_count == 1024)
constraint_2 = (sequence[0] == 'S')

# Check for consecutive M operations
consecutive_m = False
for i in range(1, len(sequence)):
    if sequence[i] == 'M' and sequence[i-1] == 'M':
        consecutive_m = True
        print(f"Found consecutive M operations at positions {i-1} and {i}")
        break

constraint_3 = not consecutive_m

print(f"\nFinal Constraint Verification:")
print(f"1. Exactly 1024 S operations: {s_count} {'✓' if constraint_1 else '✗'}")
print(f"2. First operation is S: {'✓' if constraint_2 else '✗'}")
print(f"3. No two consecutive M operations: {'✓' if constraint_3 else '✗'}")

# Display first 50 operations
print(f"\nFirst 50 operations: {sequence[:50]}")

# Save to file
with open('./result.txt', 'w') as f:
    f.write(sequence)

print(f"\nSequence successfully saved to ./result.txt")
print(f"File contains {len(sequence)} operations: {s_count} S and {m_count} M")
