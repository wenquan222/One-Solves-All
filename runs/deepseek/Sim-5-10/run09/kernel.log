# Convert labels to S and M operations
operations = []
for label in labels:
    if label == s_cluster:
        operations.append('S')
    else:
        operations.append('M')

# Convert to string
operation_sequence = ''.join(operations)

# Verify the sequence meets all constraints
print("Final Verification:")
print(f"Total operations: {len(operations)}")
print(f"S operations: {operations.count('S')}")
print(f"M operations: {operations.count('M')}")
print(f"First operation: {operations[0]}")

# Check for consecutive M operations
consecutive_m_found = False
for i in range(1, len(operations)):
    if operations[i] == 'M' and operations[i-1] == 'M':
        consecutive_m_found = True
        print(f"Consecutive M found at positions {i-1} and {i}")
        break

if not consecutive_m_found:
    print("No consecutive M operations found")

print("\nFirst 50 operations:")
print(operation_sequence[:50])

print("\nLast 50 operations:")
print(operation_sequence[-50:])

# Save to file
with open('./result.txt', 'w') as f:
    f.write(operation_sequence)

print(f"\nOperation sequence saved to ./result.txt")
