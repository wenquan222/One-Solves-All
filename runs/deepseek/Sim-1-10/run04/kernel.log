import numpy as np
import matplotlib.pyplot as plt
from sklearn.decomposition import PCA
from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler

# Load the trace data
trace = np.load('./trace/Simulated-1-10.npy')
print(f"Trace shape: {trace.shape}")
print(f"Trace length: {len(trace)}")

# Step 1: Segment the waveform into 1536 equal parts
num_segments = 1536
segment_length = len(trace) // num_segments
print(f"Segment length: {segment_length}")

# Create segments
segments = []
for i in range(num_segments):
    start_idx = i * segment_length
    end_idx = (i + 1) * segment_length
    segments.append(trace[start_idx:end_idx])

segments = np.array(segments)
print(f"Segments shape: {segments.shape}")


try:
    import matplotlib.pyplot as plt
    import json as _json
    plt.savefig("../images/img_20261006_173622_199996_1.png", dpi=160, bbox_inches='tight')
    plt.close()
    print(_json.dumps({"plot_path": "../images/img_20261006_173622_199996_1.png"}, ensure_ascii=False))
except Exception as e:
    print("图片保存失败:", str(e))

