    # Convert to string
    sequence_str = ''.join(operation_sequence)
    print(f"\nFirst 50 operations: {sequence_str[:50]}")
    print(f"Last 50 operations: {sequence_str[-50:]}")

    # Save to file
    with open('./result.txt', 'w') as f:
