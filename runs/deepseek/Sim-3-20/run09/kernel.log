        # Assign noise points to nearest cluster center
        noise_data = segments_pca6[noise_mask]
        for i, point in enumerate(noise_data):
            distances = [np.linalg.norm(point - center) for center in cluster_centers]
            labels6[np.where(noise_mask)[0][i]] = np.argmin(distances)

