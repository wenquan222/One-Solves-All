if -1 in unique_labels:
    # For noise points, use KMeans to assign them
    noise_mask = labels6 == -1
    if np.sum(noise_mask) > 0:
        # Use KMeans on non-noise points to get cluster centers
        non_noise_data = segments_pca6[~noise_mask]
        non_noise_labels = labels6[~noise_mask]

