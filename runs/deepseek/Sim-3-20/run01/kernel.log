from sklearn.cluster import DBSCAN

# Use PCA with 3 components
pca5 = PCA(n_components=3)
X_pca5 = pca5.fit_transform(X_scaled)

print(f"Total explained variance: {sum(pca5.explained_variance_ratio_)}")

