# Step 2: Dimensionality reduction and clustering
# Standardize the data first
scaler = StandardScaler()
segments_scaled = scaler.fit_transform(segments)

# Apply PCA
pca = PCA(n_components=2)
segments_pca = pca.fit_transform(segments_scaled)

# Apply KMeans clustering
kmeans = KMeans(n_clusters=2, random_state=42)
labels = kmeans.fit_predict(segments_pca)

# Determine which cluster is S (larger cluster)
cluster_counts = np.bincount(labels)
print(f"Cluster counts: {cluster_counts}")

# Assign larger cluster as S, smaller as M
if cluster_counts[0] > cluster_counts[1]:
    s_label, m_label = 0, 1
else:
    s_label, m_label = 1, 0

# Convert labels to S and M
operations = ['S' if label == s_label else 'M' for label in labels]

# Step 3: Constraint verification
s_count = operations.count('S')
first_op = operations[0]
consecutive_m = any(operations[i] == 'M' and operations[i+1] == 'M' for i in range(len(operations)-1))

print(f"\nAttempt 1 Results:")
print(f"S count: {s_count} (target: 1024) - {'PASS' if s_count == 1024 else 'FAIL'}")
print(f"First operation: {first_op} (target: S) - {'PASS' if first_op == 'S' else 'FAIL'}")
print(f"Consecutive M operations: {consecutive_m} (target: False) - {'PASS' if not consecutive_m else 'FAIL'}")

# Plot the PCA results
plt.figure(figsize=(10, 6))
colors = ['red' if op == 'S' else 'blue' for op in operations]
plt.scatter(segments_pca[:, 0], segments_pca[:, 1], c=colors, alpha=0.6)
plt.xlabel('PC1')
plt.ylabel('PC2')
plt.title('PCA + KMeans Clustering (Attempt 1)')
plt.legend(['S (Squaring)', 'M (Multiplication)'])

