        np.max(segment),       # Maximum
        np.min(segment),       # Minimum
        np.ptp(segment),       # Peak-to-peak
        np.sum(np.abs(segment)),  # Absolute sum
        np.sum(segment**2),    # Energy
        np.median(segment),    # Median
        np.percentile(segment, 25),  # 25th percentile
