# Attempt 5: Try DBSCAN clustering with PCA
from sklearn.cluster import DBSCAN

# Use PCA for dimensionality reduction
pca = PCA(n_components=2)
segments_pca = pca.fit_transform(segments_scaled)

# Apply DBSCAN clustering
dbscan = DBSCAN(eps=0.5, min_samples=10)
labels = dbscan.fit_predict(segments_pca)

print(f"Unique labels from DBSCAN: {np.unique(labels)}")
print(f"Label counts: {np.bincount(labels + 1)}")  # +1 to handle -1 (noise)

# If we have more than 2 clusters or noise, we need to handle this
if len(np.unique(labels)) > 2:
    # For DBSCAN, we need to assign the two largest clusters as S and M
    unique_labels, counts = np.unique(labels[labels != -1], return_counts=True)
    if len(unique_labels) >= 2:
        # Get the two largest clusters
        sorted_indices = np.argsort(counts)[::-1]
        s_cluster = unique_labels[sorted_indices[0]]
        m_cluster = unique_labels[sorted_indices[1]]

        # Assign noise to the larger cluster (S)
        operations = []
        for label in labels:
            if label == s_cluster or label == -1:
                operations.append('S')
            elif label == m_cluster:
                operations.append('M')
            else:
                # Assign other clusters to S (larger cluster)
                operations.append('S')
    else:
        # Fallback to KMeans if DBSCAN doesn't find enough clusters
        kmeans = KMeans(n_clusters=2, random_state=42, n_init=10)
        labels = kmeans.fit_predict(segments_pca)
        cluster_counts = np.bincount(labels)
        if cluster_counts[0] > cluster_counts[1]:
            s_cluster = 0
            m_cluster = 1
        else:
            s_cluster = 1
            m_cluster = 0

        operations = []
        for label in labels:
            if label == s_cluster:
                operations.append('S')
            else:
                operations.append('M')
else:
    # Standard case with 2 clusters
    cluster_counts = np.bincount(labels[labels != -1])
    if len(cluster_counts) == 2:
        if cluster_counts[0] > cluster_counts[1]:
            s_cluster = 0
            m_cluster = 1
        else:
            s_cluster = 1
            m_cluster = 0

    operations = []
    for label in labels:
        if label == s_cluster:
            operations.append('S')
        elif label == m_cluster:
            operations.append('M')
        else:  # noise
            operations.append('S')  # assign noise to larger cluster

operations = np.array(operations)

# Step 3: Constraint verification
s_count = np.sum(operations == 'S')
first_op = operations[0]

# Check for consecutive M operations
consecutive_m = False
for i in range(1, len(operations)):
    if operations[i] == 'M' and operations[i-1] == 'M':
        consecutive_m = True
        break

print(f"\nConstraint Verification - Attempt 5:")
print(f"1. S count: {s_count} (target: 1024) - {'PASS' if s_count == 1024 else 'FAIL'}")
print(f"2. First operation: {first_op} (target: S) - {'PASS' if first_op == 'S' else 'FAIL'}")
print(f"3. No consecutive M operations: {'PASS' if not consecutive_m else 'FAIL'}")

# Plot the results
plt.figure(figsize=(10, 6))
colors = ['red' if op == 'M' else 'blue' for op in operations]
plt.scatter(segments_pca[:, 0], segments_pca[:, 1], c=colors, alpha=0.6)
plt.xlabel('PC1')
plt.ylabel('PC2')
plt.title('PCA + DBSCAN Clustering (Red=M, Blue=S)')

