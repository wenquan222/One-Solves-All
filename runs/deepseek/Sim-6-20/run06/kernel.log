# Step 2: Dimensionality reduction and clustering
# Standardize the data first
scaler = StandardScaler()
segments_scaled = scaler.fit_transform(segments)

# Apply PCA
pca = PCA(n_components=10)  # Start with 10 components
pca_result = pca.fit_transform(segments_scaled)
print(f"Explained variance ratio: {pca.explained_variance_ratio_}")
print(f"Cumulative explained variance: {np.cumsum(pca.explained_variance_ratio_)}")

# Apply KMeans clustering
kmeans = KMeans(n_clusters=2, random_state=42, n_init=10)
labels = kmeans.fit_predict(pca_result)

# Count the occurrences of each label
unique, counts = np.unique(labels, return_counts=True)
print(f"Cluster counts: {dict(zip(unique, counts))}")

# Assign larger cluster as S (squaring)
if counts[0] > counts[1]:
    s_label = 0
    m_label = 1
else:
    s_label = 1
    m_label = 0

# Create operation sequence
operations = []
for label in labels:
    if label == s_label:
        operations.append('S')
    else:
        operations.append('M')

# Step 3: Constraint verification
s_count = operations.count('S')
first_op = operations[0]
consecutive_m = False
for i in range(1, len(operations)):
    if operations[i] == 'M' and operations[i-1] == 'M':
        consecutive_m = True
        break

print(f"\nConstraint Verification - Attempt 1:")
print(f"1. S count: {s_count} (target: 1024) - {'PASS' if s_count == 1024 else 'FAIL'}")
print(f"2. First operation: {first_op} (target: S) - {'PASS' if first_op == 'S' else 'FAIL'}")
print(f"3. No consecutive M operations: {'PASS' if not consecutive_m else 'FAIL'}")

# Check if all constraints are satisfied
all_passed = (s_count == 1024) and (first_op == 'S') and (not consecutive_m)
print(f"\nAll constraints satisfied: {'YES' if all_passed else 'NO'}")
