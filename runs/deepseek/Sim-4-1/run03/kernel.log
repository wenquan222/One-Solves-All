# Step 2: Dimensionality reduction and clustering
# First, standardize the data
scaler = StandardScaler()
segments_scaled = scaler.fit_transform(segments)

# Apply PCA
pca = PCA(n_components=2)
segments_pca = pca.fit_transform(segments_scaled)

# Apply KMeans clustering
kmeans = KMeans(n_clusters=2, random_state=42)
labels = kmeans.fit_predict(segments_pca)

# Count the labels
unique, counts = np.unique(labels, return_counts=True)
print(f"Label counts: {dict(zip(unique, counts))}")

# Assign larger cluster as S (squaring)
if counts[0] > counts[1]:
    s_label = 0
    m_label = 1
else:
    s_label = 1
    m_label = 0

# Create operation sequence
operations = []
for label in labels:
    if label == s_label:
        operations.append('S')
    else:
        operations.append('M')

# Step 3: Constraint verification
s_count = operations.count('S')
first_op = operations[0]
consecutive_m = False
for i in range(1, len(operations)):
    if operations[i] == 'M' and operations[i-1] == 'M':
        consecutive_m = True
        break

print(f"\nConstraint Verification - Attempt 1:")
print(f"1. S count: {s_count} (target: 1024) - {'PASS' if s_count == 1024 else 'FAIL'}")
print(f"2. First operation: {first_op} (target: S) - {'PASS' if first_op == 'S' else 'FAIL'}")
print(f"3. No consecutive M operations: {'PASS' if not consecutive_m else 'FAIL'}")

# Plot the PCA results
plt.figure(figsize=(10, 6))
colors = ['red' if op == 'M' else 'blue' for op in operations]
plt.scatter(segments_pca[:, 0], segments_pca[:, 1], c=colors, alpha=0.6)
plt.xlabel('PC1')
plt.ylabel('PC2')
plt.title('PCA + KMeans Clustering (Red=M, Blue=S)')

