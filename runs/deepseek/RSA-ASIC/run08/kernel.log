    constraint_3 = True
    for i in range(1, len(labels)):
        if labels[i] == m_cluster and labels[i-1] == m_cluster:
            constraint_3 = False
            break

    print(f"\nConstraint verification:")
    print(f"1. Exactly 1024 S operations: {'PASS' if constraint_1 else 'FAIL'} (found {s_count})")
