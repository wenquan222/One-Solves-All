import numpy as np
import matplotlib.pyplot as plt
from sklearn.decomposition import PCA
from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler

# Load the trace data
trace = np.load('./trace/RSA-ASIC-502272.npy')
print(f"Trace shape: {trace.shape}")
print(f"Trace length: {len(trace)}")

# Step 1: Segment the waveform into 1536 equal parts
num_segments = 1536
segment_length = len(trace) // num_segments
print(f"Segment length: {segment_length}")

# Reshape the trace into segments
segments = trace[:num_segments * segment_length].reshape(num_segments, segment_length)
print(f"Segments shape: {segments.shape}")

# Plot a few segments to visualize
plt.figure(figsize=(12, 6))
for i in range(5):
    plt.plot(segments[i], label=f'Segment {i}')
plt.title('First 5 Segments of the Power Trace')
plt.xlabel('Time Samples')
plt.ylabel('Power Consumption')
plt.legend()
plt.grid(True)

try:
    import matplotlib.pyplot as plt
    import json as _json
    plt.savefig("../images/img_20261006_171816_517056_1.png", dpi=160, bbox_inches='tight')
    plt.close()
    print(_json.dumps({"plot_path": "../images/img_20261006_171816_517056_1.png"}, ensure_ascii=False))
except Exception as e:
    print("图片保存失败:", str(e))
