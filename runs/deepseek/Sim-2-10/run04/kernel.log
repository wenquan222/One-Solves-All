# Verify the sequence more thoroughly
sequence = []
for label in labels:
    if label == s_cluster:
        sequence.append('S')
    else:
        sequence.append('M')

sequence_str = ''.join(sequence)

# Double-check all constraints
print("Final Verification:")
print(f"Total operations: {len(sequence)}")
print(f"S count: {sequence.count('S')}")
print(f"M count: {sequence.count('M')}")
print(f"First operation: {sequence[0]}")

# Check for consecutive M operations
consecutive_m_found = False
for i in range(1, len(sequence)):
    if sequence[i] == 'M' and sequence[i-1] == 'M':
        consecutive_m_found = True
        print(f"Consecutive M found at positions {i-1} and {i}")
        break

if not consecutive_m_found:
    print("No consecutive M operations found")

print(f"\nAll constraints satisfied: {sequence.count('S') == 1024 and sequence[0] == 'S' and not consecutive_m_found}")

# Display first 50 operations
print(f"\nFirst 50 operations: {sequence_str[:50]}")

# Save to file
with open('./result.txt', 'w') as f:
    f.write(sequence_str)

print("\nSequence saved to ./result.txt")
